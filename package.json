{
  "name": "snapcrawl",
  "version": "0.2.0",
  "description": "Crawl your iOS app, map every screen as a graph, and catch visual regressions between builds.",
  "type": "module",
  "bin": { "snapcrawl": "bin/snapcrawl.js" },
  "files": ["bin", "src", "ui", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node bin/snapcrawl.js demo && node bin/snapcrawl.js ui"
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "keywords": ["visual-regression", "ios", "simulator", "crawler", "screenshot", "testing", "qa", "idb"],
  "license": "MIT"
}
