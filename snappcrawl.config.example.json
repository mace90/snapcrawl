{
  "app": {
    "bundleId": "com.example.myapp"
  },
  "device": {
    "platform": "ios-sim",
    "udid": "booted"
  },
  "auth": {
    "username": "env:SNAPPCRAWL_USERNAME",
    "password": "env:SNAPPCRAWL_PASSWORD",
    "mfa": "none",
    "totpSecret": "env:SNAPPCRAWL_TOTP_SECRET",
    "fallbackManual": true
  },
  "crawl": {
    "maxDepth": 8,
    "maxScreens": 200,
    "timeLimitMin": 20,
    "blocklist": [
      "log out",
      "logout",
      "sign out",
      "abmelden",
      "delete account",
      "konto löschen",
      "buy",
      "kaufen",
      "purchase",
      "pay now",
      "jetzt zahlen",
      "kauf abschließen"
    ]
  },
  "diff": {
    "threshold": 0.1,
    "minChangedRatio": 0.0005,
    "ignoreStatusBar": true
  }
}
