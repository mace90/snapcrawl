{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mace90/snappcrawl",
  "description": "Crawl an iOS app in the Simulator and compare every screen with a baseline",
  "repository": { "url": "https://github.com/mace90/snappcrawl", "source": "github" },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "snappcrawl",
      "version": "0.4.0",
      "runtimeHint": "npx",
      "runtimeArguments": [{ "type": "named", "name": "-y" }],
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "transport": { "type": "stdio" }
    }
  ]
}
